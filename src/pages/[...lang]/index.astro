---
import Arrow from '../../components/Arrow.astro';
import ContactCard from '../../components/ContactCard.astro';
import Countdown from '../../components/Countdown.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import ExternalIcon from '../../components/ExternalIcon.astro';
import HeroScene from '../../components/HeroScene.astro';
import InfoNote from '../../components/InfoNote.astro';
import Photo from '../../components/Photo.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import ThanksCard from '../../components/ThanksCard.astro';
import { languages } from '../../content/languages';
import { abroadContact, contacts, links } from '../../data/contacts';
import Base from '../../layouts/Base.astro';
import { defaultLang, useI18n } from '../../utils/i18n';
import { isExternal } from '../../utils/rich';

// Головна кожною мовою: основна — у корені (/), інші — /en/, /pl/…
export function getStaticPaths() {
  return languages.map(({ code }) => ({ params: { lang: code === defaultLang ? undefined : code } }));
}

const { t } = useI18n(Astro);
const { about, contacts: contactTexts, help, hero, site, wyd } = t;

const { organizer, gallery } = about;
const { why, cost } = wyd;
const { steps, fundraising, other } = help;
const { abroad } = contactTexts;

const abroadHref = (abroadContact && links.telegram(abroadContact)) ?? '#contacts';

// Ділимо назву на частини, щоб виділити кольором слова з site.nameAccents
const escape = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const accents: readonly string[] = site.nameAccents;
const nameParts = accents.length
  ? site.name.split(new RegExp(`(${accents.map(escape).join('|')})`)).filter(Boolean)
  : [site.name];
---

<Base stickyStartsHidden>
  <!-- 1. Заголовок і вступ -->
  <section class="hero" id="top">
    <div class="container hero__grid">
      <div class="hero__text">
        <ul class="hero__event">
          {hero.eventLine.map((part) => <li>{part}</li>)}
        </ul>
        <h1 class="hero__title">
          {
            nameParts.map((part) => {
              const index = accents.indexOf(part);
              return index === -1 ? part : <span class={`accent-${index % 2}`}>{part}</span>;
            })
          }
        </h1>
        <p class="lead hero__subtitle">{hero.lead}</p>
        <div class="hero__note">
          <InfoNote icon="pin" text={hero.note} />
        </div>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="#help" data-sticky-hide>
            {hero.buttons.help}
            <Arrow />
          </a>
          <a class="btn btn--ghost btn--lg" href="#about">{hero.buttons.about}</a>
          <a class="btn btn--ghost btn--lg" href="#wyd">{hero.buttons.wyd}</a>
        </div>
      </div>

      <div class="hero__media">
        <div class="hero__frame">
          <Photo
            id="hero"
            ratio="16 / 10"
            priority
            widths={[400, 640, 800, 1100, 1400]}
            sizes="(min-width: 56.25em) min(46vw, 34rem), calc(100vw - 2rem)"
          />
          <p class="hero__sticker" aria-hidden="true">
            {hero.sticker.map((line) => <span>{line}</span>)}
          </p>
        </div>
      </div>
    </div>
    <HeroScene />
  </section>

  <div class="timer">
    <div class="container">
      <Countdown />
    </div>
  </div>

  <!-- 2. Хто ми -->
  <section id="about" tabindex="-1" aria-labelledby="about-title">
    <div class="section">
      <div class="container">
        <div class="about__grid">
          <div class="about__photo reveal">
            <Photo id="community" sizes="(min-width: 56.25em) 34rem, calc(100vw - 2rem)" />
          </div>
          <div class="about__text stack reveal" style="--i:1">
            <span class="eyebrow">{about.eyebrow}</span>
            <h2 id="about-title">{about.title}</h2>
            <p>{about.text}</p>
            <InfoNote icon="link" text={about.note} />
          </div>
        </div>
      </div>
    </div>

    <div class="section section--alt">
      <div class="container">
        <div class="organizer reveal">
          <p class="eyebrow">{organizer.eyebrow}</p>
          <h3 class="organizer__name">{organizer.name}</h3>
          <p>{organizer.text}</p>
          <a class="link-arrow" href="#contacts">
            {organizer.link}
            <Arrow />
          </a>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="container">
        <div class="section-head reveal">
          <h3 class="subtitle">{gallery.title}</h3>
          <p class="lead">{gallery.hint}</p>
        </div>
        <PhotoGrid ids={['hero', 'community', 'gallery1', 'gallery2', 'gallery3', 'gallery4']} />
      </div>
    </div>
  </section>

  <!-- 3. Що таке Всесвітній день молоді -->
  <section id="wyd" tabindex="-1" aria-labelledby="wyd-title">
    <div class="section section--alt">
      <div class="container split">
        <div class="prose reveal">
          <span class="eyebrow">{wyd.eyebrow}</span>
          <h2 id="wyd-title">{wyd.title}</h2>
          {wyd.text.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="trip-facts reveal" style="--i:1">
          {
            wyd.facts.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="section">
      <div class="container">
        <div class="section-head reveal">
          <h3 class="subtitle">{why.title}</h3>
        </div>
        <ol class="cards cards--3">
          {
            why.items.map((item, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <span class="card__num" aria-hidden="true">{i + 1}</span>
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="section cost">
      <div class="container split">
        <div class="reveal">
          <h3 class="subtitle">{cost.title}</h3>
          <p class="cost__sum">
            <span>{cost.prefix}</span>
            <strong>{cost.value}</strong>
            <span>{cost.label}</span>
          </p>
        </div>
        <div class="cost__details reveal" style="--i:1">
          <h4>{cost.includesTitle}</h4>
          <ul class="cost__list">
            {cost.includes.map((item) => <li>{item}</li>)}
          </ul>
          {cost.text.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Як допомогти -->
  <section id="help" tabindex="-1" aria-labelledby="help-title" data-sticky-hide>
    <div class="section">
      <div class="container">
        <CtaPanel eyebrow={help.eyebrow} title={help.title} titleId="help-title" text={help.text} button={help.button} href="#contacts" />

        <div class="section-head steps-head reveal">
          <h3 class="subtitle">{steps.title}</h3>
        </div>
        <ol class="steps">
          {
            steps.items.map((step, i) => (
              <li class="step reveal" style={`--i:${i}`}>
                <span class="step__num" aria-hidden="true">{i + 1}</span>
                <h4>{step.title}</h4>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="notice reveal">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 4.5 6v5.5c0 4.5 3 8 7.5 9.5 4.5-1.5 7.5-5 7.5-9.5V6ZM12 8v5M12 16.5v.01"></path>
          </svg>
          <span>{steps.notice}</span>
        </p>
      </div>
    </div>

    <div class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">{fundraising.eyebrow}</span>
          <h3 class="subtitle">{fundraising.title}</h3>
          <p class="lead">{fundraising.lead}</p>
        </div>
        <ul class="cards cards--2">
          {
            fundraising.events.map((event, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <h4>{event.title}</h4>
                <p>{event.text}</p>
                <p class="event-note">{event.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="section">
      <div class="container">
        <div class="section-head reveal">
          <h3 class="subtitle">{other.title}</h3>
        </div>
        <ul class="cards cards--3">
          {
            other.items.map((item, i) => (
              <li class="card reveal" style={`--i:${i}`}>
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Наша подяка -->
  <ThanksCard />

  <!-- 6. Контакти -->
  <section class="section section--alt" id="contacts" tabindex="-1" aria-labelledby="contacts-title" data-sticky-hide>
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{contactTexts.eyebrow}</span>
        <h2 id="contacts-title">{contactTexts.title}</h2>
        <p class="lead">{contactTexts.lead}</p>
      </div>
      <div class="contacts__grid">
        {
          contacts.map((contact, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <ContactCard contact={contact} />
            </div>
          ))
        }
      </div>

      <div class="abroad reveal">
        <div>
          <h3>{abroad.title}</h3>
          <p>{abroad.text}</p>
        </div>
        {
          isExternal(abroadHref) ? (
            <a class="btn btn--ghost" href={abroadHref} data-link="abroad" target="_blank" rel="noopener noreferrer">
              <span>{abroad.button}<ExternalIcon /></span>
            </a>
          ) : (
            <a class="btn btn--ghost" href={abroadHref} data-link="abroad">
              {abroad.button}
              <Arrow />
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Перший екран ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 30rem at 100% 0%, var(--c-pink-tint), transparent 70%),
      radial-gradient(40rem 26rem at 0% 30%, var(--c-jade-tint), transparent 70%), var(--c-bg);
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-6);
    padding-top: var(--s-6);
  }

  .hero__event {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0 0 var(--s-4);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-indigo);
  }

  .hero__event li {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__event li + li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--c-red);
  }

  /* На вузькому екрані назва події стоїть окремим рядком */
  @media (max-width: 29.99em) {
    .hero__event li:first-child {
      flex-basis: 100%;
    }

    .hero__event li:nth-child(2)::before {
      display: none;
    }
  }

  .hero__title {
    color: var(--c-indigo-deep);
  }

  .hero__title .accent-0 {
    color: var(--c-red);
  }

  .hero__title .accent-1 {
    color: var(--c-jade-dark);
  }

  .hero__subtitle {
    max-width: 34rem;
    margin-top: var(--s-4);
  }

  .hero__note {
    margin-top: var(--s-4);
  }

  /* На мобільному кнопки стоять у стовпчик на всю ширину */
  .hero__actions {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .hero__actions .btn {
    text-align: center;
  }

  .hero__media {
    position: relative;
    z-index: 1;
    margin-bottom: -2.5rem;
  }

  .hero__frame {
    position: relative;
    padding: 0.5rem;
    border-radius: calc(var(--r-lg) + 0.5rem);
    background: var(--c-surface);
    box-shadow: var(--shadow-lg);
  }

  .hero__sticker {
    position: absolute;
    top: -1rem;
    right: -0.25rem;
    display: grid;
    place-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--c-red);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    transform: rotate(10deg);
    box-shadow: var(--shadow-md);
  }

  .hero__sticker span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__media {
        animation: hero-photo-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes hero-photo-drift {
    to {
      transform: translateY(-2.5rem);
    }
  }

  @media (min-width: 56.25em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-8);
      padding-top: var(--s-8);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }

    .hero__media {
      margin-bottom: -4rem;
    }

    .hero__frame {
      transform: rotate(1.5deg);
    }

    .hero__sticker {
      top: -1.5rem;
      right: -1.5rem;
      width: 6.5rem;
      height: 6.5rem;
      font-size: 1rem;
    }
  }

  /* ---------- Таймер ---------- */

  .timer {
    padding-block: var(--s-7) calc(var(--s-7) + var(--s-2));
    background: var(--c-indigo);
  }

  /* ---------- Хто ми ---------- */

  .about__grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  .about__photo {
    box-shadow: var(--shadow-md);
    border-radius: var(--r-lg);
  }

  @media (min-width: 56.25em) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-8);
    }
  }

  .organizer {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
    max-width: 46rem;
    padding: var(--s-5);
    border-radius: var(--r-xl);
    border-left: 0.375rem solid var(--c-red);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .organizer__name {
    font-weight: 700;
    color: var(--c-indigo-deep);
  }

  /* Підзаголовок блоку всередині секції: h3 з виглядом заголовка секції */
  .subtitle {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: var(--lh-tight);
  }

  @media (min-width: 48em) {
    .organizer {
      padding: var(--s-6) var(--s-7);
    }
  }

  /* ---------- Що таке Всесвітній день молоді ---------- */

  .trip-facts {
    display: grid;
    margin: 0;
    padding: var(--s-2) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .trip-facts div {
    display: grid;
    gap: 0.125rem;
    padding-block: var(--s-4);
  }

  .trip-facts div + div {
    border-top: 1px solid var(--c-line);
  }

  .trip-facts dt {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-red-dark);
  }

  .trip-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-indigo-deep);
  }

  .cost {
    background: var(--c-indigo);
    color: #fff;
  }

  .cost__sum {
    display: grid;
    gap: 0.25rem;
    margin-top: var(--s-5);
    font-weight: 700;
    color: #dfe3f5;
  }

  .cost__sum strong {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--c-pink);
  }

  .cost__details {
    display: grid;
    gap: var(--s-4);
    color: #dfe3f5;
  }

  .cost__details h4 {
    color: #fff;
  }

  .cost__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
  }

  .cost__list li {
    padding: 0.5rem 1rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    font-weight: 700;
    color: #fff;
  }

  /* ---------- Як допомогти ---------- */

  .steps-head {
    margin-top: var(--s-8);
  }

  .steps {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-md);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    background: var(--c-red);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .step:nth-child(2) .step__num {
    background: var(--c-jade-dark);
  }

  .step:nth-child(3) .step__num {
    background: var(--c-indigo);
  }

  .step h4 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    color: var(--c-indigo-deep);
  }

  .step p {
    color: var(--c-ink-soft);
  }

  .notice {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    max-width: 46rem;
    margin-top: var(--s-6);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    background: var(--c-red-tint);
    color: var(--c-ink);
    font-weight: 600;
  }

  .notice svg {
    flex: none;
    margin-top: 0.125rem;
    color: var(--c-red-dark);
  }

  .event-note {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  @media (min-width: 48em) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .step {
      padding: var(--s-6);
    }
  }

  /* ---------- Контакти ---------- */

  .contacts__grid {
    display: grid;
    gap: var(--s-4);
  }

  .abroad {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-jade-tint);
  }

  .abroad h3 {
    color: var(--c-indigo-deep);
  }

  .abroad p {
    margin-top: var(--s-2);
  }

  @media (min-width: 48em) {
    .contacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .abroad {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--s-5) var(--s-6);
    }
  }
</style>
