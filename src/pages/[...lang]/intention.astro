---
import Arrow from '../../components/Arrow.astro';
import Rich from '../../components/Rich.astro';
import { languages } from '../../content/languages';
import Base from '../../layouts/Base.astro';
import { defaultLang, useI18n } from '../../utils/i18n';

// Форма інтенцій кожною мовою: /intention/, /en/intention/… На неї веде кнопка в секції контактів на головній (#intentions).
// Дані приймає functions/api/intention.ts (працює лише на Cloudflare, не в npm run dev)
export function getStaticPaths() {
  return languages.map(({ code }) => ({ params: { lang: code === defaultLang ? undefined : code } }));
}

const { t, link } = useI18n(Astro);
const { intention } = t;
const { fields, success, errors } = intention;
---

<Base title={intention.title} description={intention.lead} noindex ownLanguages stickyStartsHidden>
  <section class="section intent" id="intention" data-sticky-hide>
    <div class="container intent__body">
      <a class="link-arrow intent__back" href={link('/#intentions')}>
        <Arrow />
        {intention.back}
      </a>
      <div class="section-head">
        <p class="eyebrow">{intention.eyebrow}</p>
        <h1>{intention.heading}</h1>
        <p class="lead">{intention.lead}</p>
      </div>

      <form class="intent__form" novalidate data-sending={intention.sending} data-error-required={errors.required} data-error-consent={errors.consent} data-error-failed={errors.failed}>
        <div class="intent__row">
          <div class="field">
            <label for="intent-first">{fields.firstName}</label>
            <input id="intent-first" name="firstName" type="text" autocomplete="given-name" maxlength="80" aria-describedby="intent-first-error" required />
            <p class="field__error" id="intent-first-error" hidden></p>
          </div>
          <div class="field">
            <label for="intent-last">{fields.lastName}</label>
            <input id="intent-last" name="lastName" type="text" autocomplete="family-name" maxlength="80" aria-describedby="intent-last-error" required />
            <p class="field__error" id="intent-last-error" hidden></p>
          </div>
        </div>

        <div class="field">
          <label for="intent-phone">{fields.phone}</label>
          <input id="intent-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="intent-phone-error intent-phone-hint" required />
          <p class="field__error" id="intent-phone-error" hidden></p>
          <p class="field__hint" id="intent-phone-hint">{fields.phoneHint}</p>
        </div>

        <div class="field">
          <label for="intent-text">{fields.intention}</label>
          <textarea id="intent-text" name="intention" rows="4" maxlength="2000" aria-describedby="intent-text-error intent-text-hint" required></textarea>
          <p class="field__error" id="intent-text-error" hidden></p>
          <p class="field__hint" id="intent-text-hint">{fields.intentionHint}</p>
        </div>

        <!-- Поле-пастка для ботів: людям його не видно -->
        <div class="intent__trap" aria-hidden="true">
          <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="consent">
          <label class="consent__label">
            <input name="consent" type="checkbox" aria-required="true" />
            <span>{intention.consent}</span>
          </label>
          <details class="consent__details">
            <summary>{intention.privacyToggle}</summary>
            <p><Rich text={intention.privacy} /></p>
          </details>
        </div>

        <p class="intent__error" role="alert" hidden></p>

        <button class="btn btn--primary" type="submit" data-link="intention-send">
          <span>{intention.submit}</span>
          <Arrow />
        </button>
      </form>

      <div class="intent__done" tabindex="-1" hidden>
        <h2>{success.title}</h2>
        <p class="lead">{success.text}</p>
        <a class="btn btn--primary" href={link('/')}>
          {success.button}
          <Arrow />
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.intent__form');
  const done = document.querySelector<HTMLElement>('.intent__done');
  const error = form?.querySelector<HTMLElement>('.intent__error');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = button?.querySelector('span');

  const consent = form?.querySelector<HTMLInputElement>('input[name="consent"]');

  if (form && done && error && button && label && consent) {
    const fail = (message?: string) => {
      error.textContent = message ?? '';
      error.hidden = false;
    };
    consent.addEventListener('change', () => {
      consent.removeAttribute('aria-invalid');
      error.hidden = true;
    });

    // Обов’язкові поля перевіряємо самі (форма з novalidate): підказка під полем буде мовою сторінки
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field [required]')];
    const mark = (field: HTMLInputElement | HTMLTextAreaElement, message = '') => {
      const note = field.parentElement?.querySelector<HTMLElement>('.field__error');
      if (!note) return;
      note.textContent = message;
      note.hidden = !message;
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    };
    fields.forEach((field) => field.addEventListener('input', () => mark(field)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      const empty = fields.filter((field) => !field.value.trim());
      fields.forEach((field) => {
        const name = field.labels?.[0]?.textContent?.trim() ?? '';
        mark(field, empty.includes(field) ? (form.dataset.errorRequired ?? '').replace('{field}', name) : '');
      });
      if (empty.length) {
        error.hidden = true;
        empty[0].focus();
        return;
      }
      // Без галочки згоди форму не надсилаємо. Перевіряємо самі, а не через required: підказка буде мовою сторінки
      if (!consent.checked) {
        consent.setAttribute('aria-invalid', 'true');
        fail(form.dataset.errorConsent);
        consent.focus();
        return;
      }
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? '');

      const idle = label.textContent;
      button.disabled = true;
      label.textContent = form.dataset.sending ?? idle;
      error.hidden = true;

      let status = 0;
      try {
        const response = await fetch('/api/intention', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: value('firstName'),
            lastName: value('lastName'),
            phone: value('phone'),
            intention: value('intention'),
            website: value('website'),
            consent: consent.checked,
            lang: document.documentElement.lang,
          }),
        });
        status = response.status;
      } catch {}

      if (status === 204) {
        form.hidden = true;
        done.hidden = false;
        // Форма була довга: повертаємо подяку на екран
        done.focus({ preventScroll: true });
        document.getElementById('intention')?.scrollIntoView();
        return;
      }
      fail(form.dataset.errorFailed);
      button.disabled = false;
      label.textContent = idle;
    });
  }
</script>

<style>
  /* Форма компактна: менші відступи й шрифти, ніж у секціях головної */
  .intent {
    padding-block: clamp(var(--s-5), 4vw, var(--s-7));
    background: var(--c-bg);
  }

  .intent__body {
    max-width: 40rem;
  }

  .intent__back {
    margin-bottom: var(--s-4);
  }

  .intent .section-head {
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }

  .intent .lead {
    font-size: var(--fs-base);
  }

  /* Стрілка та сама, що на кнопках, але дивиться назад */
  .intent__back :global(svg) {
    order: -1;
    rotate: 180deg;
  }

  .intent h1,
  .intent h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    color: var(--c-indigo-deep);
  }

  .intent__form,
  .intent__done {
    display: grid;
    gap: var(--s-4);
    padding: clamp(var(--s-4), 3vw, var(--s-5));
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .intent__done {
    justify-items: start;
    gap: var(--s-3);
  }

  .intent__done:focus {
    outline: none;
  }

  .intent__form[hidden],
  .intent__done[hidden] {
    display: none;
  }

  /* Ім’я й прізвище поруч навіть на телефоні: поля короткі */
  .intent__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 36em) {
    .intent__row {
      gap: var(--s-4);
    }
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-indigo-deep);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--c-line);
    border-radius: var(--r-sm);
    background: var(--c-bg);
    color: var(--c-ink);
    font: inherit;
    transition: border-color var(--t-fast) var(--ease);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--c-indigo);
    outline-offset: 0;
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: var(--c-red);
  }

  .field__error {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--c-red-dark);
  }

  .field__hint {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }

  /* Поле-пастка стоїть за межами екрана: display: none боти вміють обходити */
  .intent__trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: grid;
    gap: var(--s-1);
  }

  .consent__label {
    display: flex;
    gap: var(--s-2);
    font-size: 0.9375rem;
    line-height: 1.45;
    align-items: flex-start;
    cursor: pointer;
  }

  .consent__label input {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    accent-color: var(--c-red);
    cursor: pointer;
  }

  .consent__label input[aria-invalid='true'] {
    outline: 2px solid var(--c-red);
    outline-offset: 2px;
  }

  /* Примітка про дані розгортається кліком на слова під галочкою */
  .consent__details {
    padding-left: calc(1.125rem + var(--s-2));
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }

  .consent__details summary {
    width: fit-content;
    color: var(--c-indigo);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .consent__details p {
    margin-top: var(--s-1);
    line-height: 1.5;
  }

  .intent__error {
    padding: var(--s-2) var(--s-3);
    font-size: 0.9375rem;
    border-radius: var(--r-sm);
    background: var(--c-red-tint);
    color: var(--c-red-dark);
    font-weight: 700;
  }

  .intent__form .btn {
    justify-self: start;
  }

  .intent__form .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>
