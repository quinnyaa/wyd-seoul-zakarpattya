---
import CtaPanel from '../components/CtaPanel.astro';
import PageHero from '../components/PageHero.astro';
import { trip } from '../content/texts';
import Base from '../layouts/Base.astro';

const { hero, what, why, cost, cta } = trip;
---

<Base title={trip.title} description={trip.description}>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} lead={hero.lead} />

  <!-- 1. Що таке Всесвітній день молоді -->
  <section class="section">
    <div class="container split">
      <div class="prose reveal">
        <h2>{what.title}</h2>
        {what.text.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="trip-facts reveal" style="--i:1">
        {
          what.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 2. Чому це важливо для нас -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <h2>{why.title}</h2>
      </div>
      <ol class="cards cards--3">
        {
          why.items.map((item, i) => (
            <li class="card reveal" style={`--i:${i}`}>
              <span class="card__num" aria-hidden="true">{i + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. Скільки це коштує -->
  <section class="section cost">
    <div class="container split">
      <div class="reveal">
        <h2>{cost.title}</h2>
        <p class="cost__sum">
          <span>{cost.prefix}</span>
          <strong>{cost.value}</strong>
          <span>{cost.label}</span>
        </p>
      </div>
      <div class="cost__details reveal" style="--i:1">
        <h3>{cost.includesTitle}</h3>
        <ul class="cost__list">
          {cost.includes.map((item) => <li>{item}</li>)}
        </ul>
        {cost.text.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <CtaPanel title={cta.title} text={cta.text} button={cta.button} />
</Base>

<style>
  .trip-facts {
    display: grid;
    margin: 0;
    padding: var(--s-2) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .trip-facts div {
    display: grid;
    gap: 0.125rem;
    padding-block: var(--s-4);
  }

  .trip-facts div + div {
    border-top: 1px solid var(--c-line);
  }

  .trip-facts dt {
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-red-dark);
  }

  .trip-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-indigo-deep);
  }

  .cost {
    background: var(--c-indigo);
    color: #fff;
  }

  .cost__sum {
    display: grid;
    gap: 0.25rem;
    margin-top: var(--s-5);
    font-weight: 700;
    color: #dfe3f5;
  }

  .cost__sum strong {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--c-pink);
  }

  .cost__details {
    display: grid;
    gap: var(--s-4);
    color: #dfe3f5;
  }

  .cost__details h3 {
    color: #fff;
  }

  .cost__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
  }

  .cost__list li {
    padding: 0.5rem 1rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    font-weight: 700;
    color: #fff;
  }
</style>
