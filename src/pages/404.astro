---
import Arrow from '../components/Arrow.astro';
import HeroScene from '../components/HeroScene.astro';
import { notFound } from '../content/texts';
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base title={notFound.title} noindex>
  <section class="lost">
    <div class="container lost__body">
      <p class="lost__code" aria-hidden="true">404</p>
      <h1>{notFound.heading}</h1>
      <p class="lead">{notFound.text}</p>
      <a class="btn btn--primary btn--lg" href={url('/')}>
        {notFound.button}
        <Arrow />
      </a>
    </div>
    <HeroScene />
  </section>
</Base>

<style>
  .lost {
    background: var(--c-bg);
    overflow: hidden;
  }

  .lost__body {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding-block: var(--s-8) var(--s-7);
    text-align: center;
  }

  .lost__code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 12vw, 9rem);
    font-weight: 800;
    line-height: 1;
    color: var(--c-red);
  }

  .lost h1 {
    font-size: var(--fs-h2);
    color: var(--c-indigo-deep);
  }
</style>
