---
import Arrow from '../components/Arrow.astro';
import ContactCard from '../components/ContactCard.astro';
import PageHero from '../components/PageHero.astro';
import ThanksCard from '../components/ThanksCard.astro';
import { help } from '../content/texts';
import { abroadContact, contacts, links } from '../data/contacts';
import Base from '../layouts/Base.astro';

const { hero, steps, card, other, abroad } = help;
const abroadHref = (abroadContact && (links.email(abroadContact) ?? links.telegram(abroadContact))) ?? '#contacts';
---

<Base
  title={help.title}
  description={help.description}
  stickyHref="#contacts"
  stickyLabel={hero.button}
  stickyStartsHidden
>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} lead={hero.lead} tone="accent">
    <a class="btn btn--primary btn--lg" href="#contacts" data-sticky-hide>
      {hero.button}
      <Arrow />
    </a>
  </PageHero>

  <!-- 1. Як це працює -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>{steps.title}</h2>
      </div>
      <ol class="steps">
        {
          steps.items.map((step, i) => (
            <li class="step reveal" style={`--i:${i}`}>
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="notice reveal">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3 4.5 6v5.5c0 4.5 3 8 7.5 9.5 4.5-1.5 7.5-5 7.5-9.5V6ZM12 8v5M12 16.5v.01"></path>
        </svg>
        <span>{steps.notice}</span>
      </p>
    </div>
  </section>

  <!-- 2. Подячна візитівка -->
  <ThanksCard text={card.text} />

  <!-- 3. Інші способи допомогти -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>{other.title}</h2>
      </div>
      <ul class="cards cards--3">
        {
          other.items.map((item, i) => (
            <li class="card reveal" style={`--i:${i}`}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Контакти -->
  <section class="section section--alt contacts" id="contacts" data-sticky-hide>
    <div class="container">
      <div class="section-head reveal">
        <h2>{help.contacts.title}</h2>
        <p class="lead">{help.contacts.lead}</p>
      </div>
      <div class="contacts__grid">
        {
          contacts.map((contact, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <ContactCard contact={contact} />
            </div>
          ))
        }
      </div>

      <!-- 5. За кордоном -->
      <div class="abroad reveal">
        <div>
          <h2>{abroad.title}</h2>
          <p>{abroad.text}</p>
        </div>
        <a class="btn btn--ghost" href={abroadHref} data-link="abroad">
          {abroad.button}
          <Arrow />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .steps {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-md);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    background: var(--c-red);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .step:nth-child(2) .step__num {
    background: var(--c-jade-dark);
  }

  .step:nth-child(3) .step__num {
    background: var(--c-indigo);
  }

  .step h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    color: var(--c-indigo-deep);
  }

  .step p {
    color: var(--c-ink-soft);
  }

  .notice {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    max-width: 46rem;
    margin-top: var(--s-6);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    background: var(--c-red-tint);
    color: var(--c-ink);
    font-weight: 600;
  }

  .notice svg {
    flex: none;
    margin-top: 0.125rem;
    color: var(--c-red-dark);
  }

  .contacts {
    scroll-margin-top: var(--header-h);
  }

  .contacts__grid {
    display: grid;
    gap: var(--s-4);
  }

  .abroad {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-jade-tint);
  }

  .abroad h2 {
    font-size: var(--fs-h3);
    color: var(--c-indigo-deep);
  }

  .abroad p {
    margin-top: var(--s-2);
  }

  @media (min-width: 48em) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .step {
      padding: var(--s-6);
    }

    .contacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-5);
    }

    .abroad {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--s-5) var(--s-6);
    }
  }

  @media (min-width: 64em) {
    .contacts__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
