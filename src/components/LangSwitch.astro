---
/*
  Вибір мови: кнопка з прапором поточної мови відкриває список «прапор + назва».
  З’являється, коли в src/content/languages.ts більше однієї мови.
  На телефоні стоїть угорі меню, на широкому екрані — праворуч у шапці.
  Перехід веде на ту саму секцію, яку зараз видно на екрані.
*/
import type { alternates } from '../utils/i18n';
import { useI18n } from '../utils/i18n';

interface Props {
  links: ReturnType<typeof alternates>;
}

const { links } = Astro.props;
const { lang, t } = useI18n(Astro);
const current = links.find((item) => item.code === lang)!;

// Прапори з пакета flag-icons; на сторінку вбудовуються лише ті, що потрібні
const svgs = import.meta.glob<string>('/node_modules/flag-icons/flags/4x3/*.svg', { query: '?raw', import: 'default' });
const flags = Object.fromEntries(
  await Promise.all(
    links.map(async ({ flag }) => {
      const load = svgs[`/node_modules/flag-icons/flags/4x3/${flag}.svg`];
      if (!load) throw new Error(`Немає прапора «${flag}» (src/content/languages.ts): див. node_modules/flag-icons/flags/4x3/`);
      return [flag, `data:image/svg+xml,${encodeURIComponent(await load())}`];
    }),
  ),
);
---

<div class="langs" data-langs>
  <button
    class="langs__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="langs-list"
    aria-label={`${t.site.languages}: ${current.name}`}
    data-langs-toggle
    data-link="lang"
  >
    <img class="langs__flag" src={flags[current.flag]} alt="" width="20" height="15" />
    <span class="langs__name">{current.name}</span>
    <span class="langs__short">{current.short}</span>
    <svg class="langs__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <ul class="langs__list" id="langs-list" aria-label={t.site.languages}>
    {
      links.map((item) => (
        <li>
          <a
            class="langs__link"
            href={item.href}
            hreflang={item.code}
            lang={item.code}
            aria-current={item.code === lang ? 'true' : undefined}
            data-lang-switch
            data-link={`lang-${item.code}`}
          >
            <img class="langs__flag" src={flags[item.flag]} alt="" width="20" height="15" />
            <span>{item.name}</span>
            {item.code === lang && (
              <svg class="langs__check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 12.5 4.5 4.5L19 7.5"></path>
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const root = () => document.querySelector<HTMLElement>('[data-langs]');
  const isOpen = () => root()?.classList.contains('is-open') ?? false;

  function setOpen(open: boolean, returnFocus = false) {
    const box = root();
    const toggle = box?.querySelector<HTMLButtonElement>('[data-langs-toggle]');
    if (!box || !toggle) return;
    box.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (returnFocus) toggle.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-langs-toggle]')) {
      setOpen(!isOpen());
      return;
    }
    // Ведемо на ту саму секцію, яку зараз видно (її підсвічує меню в шапці)
    const link = target.closest<HTMLAnchorElement>('[data-lang-switch]');
    if (link) {
      // Обрана мова важить більше за мову браузера, коли людина знову відкриє / (functions/index.ts)
      document.cookie = `lang=${link.hreflang}; path=/; max-age=31536000; samesite=lax`;
      link.hash = document.querySelector<HTMLAnchorElement>('.menu__link[aria-current]')?.hash ?? '';
      return;
    }
    if (isOpen() && !target.closest('[data-langs]')) setOpen(false);
  });

  // capture: Esc спершу закриває список мов, а відкрите мобільне меню лишається
  document.addEventListener(
    'keydown',
    (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      event.stopPropagation();
      setOpen(false, true);
    },
    true,
  );

  // Фокус пішов зі списку клавіатурою — закриваємо
  document.addEventListener('focusin', (event) => {
    if (isOpen() && !root()?.contains(event.target as Node)) setOpen(false);
  });
</script>

<style>
  .langs {
    position: relative;
  }

  /* Без JavaScript кнопки немає, а мови стоять рядком */
  .langs__toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.75rem 0 0.875rem;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--c-line);
    font: inherit;
    font-weight: 700;
    color: var(--c-indigo-deep);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--t-fast) var(--ease);
  }

  :global(.js) .langs__toggle {
    display: inline-flex;
  }

  .langs__toggle:hover,
  .langs.is-open .langs__toggle {
    background: var(--c-indigo-tint);
  }

  .langs__flag {
    flex: none;
    width: 1.25rem;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgb(20 27 71 / 0.12);
  }

  .langs__short {
    display: none;
  }

  .langs__chevron {
    transition: transform var(--t-fast) var(--ease);
  }

  .langs.is-open .langs__chevron {
    transform: rotate(180deg);
  }

  .langs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.js) .langs__list {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 10;
    display: grid;
    min-width: 13rem;
    padding: 0.375rem;
    border-radius: var(--r-md);
    background: var(--c-surface);
    box-shadow: var(--shadow-lg);
  }

  :global(.js) .langs:not(.is-open) .langs__list {
    display: none;
  }

  .langs__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--r-sm);
    font-weight: 600;
    color: var(--c-indigo-deep);
    text-decoration: none;
  }

  .langs__link:hover {
    background: var(--c-indigo-tint);
  }

  .langs__link[aria-current] {
    font-weight: 800;
  }

  .langs__check {
    margin-left: auto;
    color: var(--c-red);
  }

  /* На широкому екрані на кнопці — коротка назва, список вирівняно по правому краю */
  @media (min-width: 72em) {
    .langs__toggle {
      gap: 0.4375rem;
      padding: 0 0.625rem 0 0.75rem;
      font-size: 0.875rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .langs__name {
      display: none;
    }

    .langs__short {
      display: inline;
    }

    :global(.js) .langs__list {
      left: auto;
      right: 0;
    }
  }
</style>
