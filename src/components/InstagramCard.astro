---
/* Картка Instagram поруч із контактом. Ім’я користувача — у src/data/contacts.ts. */
import ExternalIcon from './ExternalIcon.astro';
import { contacts as texts } from '../content/texts';
import { links } from '../data/contacts';

interface Props {
  username: string;
}

const { username } = Astro.props;
---

<article class="insta" data-instagram>
  <h3 class="insta__title">{texts.instagramTitle}</h3>
  <a class="insta__link" href={links.instagram(username)} data-link="instagram" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5ZM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM16.8 7.2v.01"></path>
    </svg>
    <span>@{username}<ExternalIcon /></span>
  </a>
</article>

<style>
  .insta {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    height: 100%;
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--t-base) var(--ease);
  }

  .insta:hover {
    transform: translateY(-4px);
  }

  .insta__title {
    color: var(--c-indigo-deep);
  }

  .insta__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 4rem;
    padding: 0.625rem 1rem;
    border-radius: var(--r-md);
    background: var(--c-pink-tint);
    color: var(--c-indigo-deep);
    font-size: 1.125rem;
    font-weight: 800;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: transform var(--t-fast) var(--ease);
  }

  .insta__link:hover {
    transform: translateY(-2px);
  }

  .insta__link:active {
    transform: scale(0.97);
  }
</style>
