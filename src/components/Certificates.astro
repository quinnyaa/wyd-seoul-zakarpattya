---
/*
  Сертифікати від благодійників у секції «Подарунки»: згорнуті під кнопкою, розгортаються кліком.
  Клік по сертифікату відкриває його збільшеним у Lightbox (він уже є на сторінці разом із галереєю).
*/
import { getImage, Image } from 'astro:assets';
import { useI18n } from '../utils/i18n';

const { certificates } = useI18n(Astro).t.gifts;

// Файли сертифікатів: src/assets/gifts/certificates/<ключ>.jpg
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gifts/certificates/*.jpg', { eager: true });
const keys = Object.keys(certificates.items) as (keyof typeof certificates.items)[];

const items = await Promise.all(
  keys.map(async (key) => {
    const image = files[`../assets/gifts/certificates/${key}.jpg`]!.default;
    const full = await getImage({ src: image, width: Math.min(1800, image.width), format: 'webp', quality: 80 });
    const title = certificates.items[key];
    return { key, image, full, title, alt: `${certificates.label}: ${title}` };
  }),
);
---

<div class="certs" data-certs>
  <button class="certs__toggle" type="button" aria-expanded="false" aria-controls="certs-panel" data-certs-toggle data-link="certificates">
    <span class="certs__toggle-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5V10a2 2 0 0 0 0 4v2.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5V14a2 2 0 0 0 0-4z" />
        <path d="M15 6v2M15 11v2M15 16v2" />
      </svg>
    </span>
    <span class="certs__toggle-text">{certificates.toggle}</span>
    <span class="certs__count" aria-hidden="true">{items.length}</span>
    <span class="certs__chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </span>
  </button>

  <div class="certs__panel" id="certs-panel" data-certs-panel inert>
    <div class="certs__inner">
      <p class="certs__note">{certificates.note}</p>
      <ul class="certs__grid">
        {
          items.map(({ key, image, full, title, alt }, i) => (
            <li style={`--i:${i}`}>
              <button
                class="certs__item"
                type="button"
                data-lightbox-item
                data-lightbox-group="certificates"
                data-link={`certificate-${key}`}
                data-full={full.src}
                data-width={full.attributes.width}
                data-height={full.attributes.height}
                data-alt={alt}
              >
                <span class="certs__frame">
                  <Image
                    src={image}
                    alt={alt}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 56.25em) 22rem, (min-width: 36em) 46vw, calc(100vw - 2rem)"
                    format="webp"
                    quality={78}
                    loading="lazy"
                  />
                  <span class="certs__zoom" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" />
                    </svg>
                  </span>
                </span>
                <span class="certs__title">{title}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="certs__more">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8zM18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" />
        </svg>
        {certificates.more}
      </p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-certs]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-certs-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-certs-panel]')!;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.toggle('certs--open', open);
      panel.inert = !open;
    });
  });
</script>

<style>
  /* ---------- Кнопка ---------- */

  .certs__toggle {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    width: 100%;
    padding: 0.75rem 0.875rem 0.75rem 0.75rem;
    border: 0;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgb(226 177 94 / 0.2), rgb(226 177 94 / 0.08));
    box-shadow: inset 0 0 0 1.5px rgb(226 177 94 / 0.55);
    font: inherit;
    font-weight: 800;
    line-height: 1.3;
    text-align: start;
    color: #fff;
    cursor: pointer;
    transition:
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease),
      background var(--t-fast) var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .certs__toggle:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, rgb(226 177 94 / 0.28), rgb(226 177 94 / 0.12));
    box-shadow:
      inset 0 0 0 1.5px var(--c-gold),
      0 14px 30px rgb(5 8 30 / 0.35);
  }

  .certs__toggle:active {
    transform: translateY(0) scale(0.99);
  }

  .certs__toggle:focus-visible {
    outline-color: var(--c-gold-light);
  }

  .certs__toggle-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-gold-light), var(--c-gold));
    color: var(--c-indigo-deep);
  }

  .certs__toggle-text {
    flex: 1;
    font-size: 1.0625rem;
  }

  .certs__count {
    display: grid;
    flex: none;
    place-items: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding-inline: 0.5rem;
    border-radius: var(--r-pill);
    background: var(--c-red);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .certs__chevron {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--c-gold-light);
    transition: transform var(--t-base) var(--ease);
  }

  .certs--open .certs__chevron {
    transform: rotate(180deg);
  }

  /* ---------- Панель: висота плавно від 0 до вмісту ---------- */

  .certs__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--t-slow) var(--ease);
  }

  .certs--open .certs__panel {
    grid-template-rows: 1fr;
  }

  .certs__inner {
    min-height: 0;
    overflow: hidden;
  }

  .certs__note {
    margin: var(--s-5) 0 var(--s-4);
    font-size: var(--fs-sm);
    color: #aab3dc;
  }

  .certs__grid {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0 0.25rem 0.75rem;
    list-style: none;
  }

  @media (min-width: 36em) {
    .certs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56.25em) {
    .certs__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6) var(--s-5);
    }
  }

  /* Картки з'являються по черзі після розгортання */
  .certs__grid li {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .certs--open .certs__grid li {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .certs__panel,
    .certs__grid li {
      transition: none;
    }
  }

  /* Рядок «Та багато чого іншого!» під сіткою, з'являється останнім */
  .certs__more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin: var(--s-4) 0 var(--s-2);
    padding: 0.875rem var(--s-5);
    border: 1.5px dashed rgb(226 177 94 / 0.55);
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.3;
    text-align: center;
    color: var(--c-gold-light);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .certs__more svg {
    flex: none;
  }

  .certs--open .certs__more {
    opacity: 1;
    transition-delay: 520ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .certs__more {
      transition: none;
    }
  }

  /* ---------- Сертифікат ---------- */

  .certs__item {
    display: grid;
    gap: var(--s-3);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: start;
    color: inherit;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }

  .certs__item:focus-visible {
    outline-color: var(--c-gold-light);
    outline-offset: 4px;
    border-radius: var(--r-lg);
  }

  .certs__frame {
    position: relative;
    display: block;
    padding: 0.3125rem;
    border-radius: calc(var(--r-md) + 0.3125rem);
    background: linear-gradient(135deg, var(--c-gold-light), var(--c-gold) 55%, #b9853a);
    box-shadow: 0 16px 34px rgb(5 8 30 / 0.4);
    transform: rotate(var(--tilt, -1deg));
    transition:
      transform var(--t-base) var(--ease),
      box-shadow var(--t-base) var(--ease);
  }

  .certs__grid li:nth-child(even) .certs__frame {
    --tilt: 1deg;
  }

  .certs__item:hover .certs__frame {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      0 22px 44px rgb(5 8 30 / 0.5),
      0 0 40px rgb(226 177 94 / 0.25);
  }

  .certs__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    border-radius: var(--r-md);
    background: #fff;
  }

  .certs__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(20 27 71 / 0.72);
    color: #fff;
    transition: transform var(--t-fast) var(--ease);
  }

  .certs__item:hover .certs__zoom {
    transform: scale(1.12);
  }

  .certs__title {
    padding-inline: 0.25rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--c-gold-light);
  }
</style>
