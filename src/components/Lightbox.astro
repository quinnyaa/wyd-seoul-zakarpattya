---
/*
  Збільшене фото. Відкривається кліком по елементу з data-lightbox-item.
  Закривається: Esc, клік поза фото, кнопка, свайп угору чи вниз.
  Свайп убік і стрілки на клавіатурі гортають фото.
  data-lightbox-group відокремлює набори: гортаються лише елементи з тієї ж групи, що й відкритий.
*/
import { useI18n } from '../utils/i18n';

const { photos } = useI18n(Astro).t;
---

<dialog class="lightbox" data-lightbox aria-label={photos.viewer}>
  <figure class="lightbox__stage" data-lightbox-stage>
    <div class="lightbox__content" data-lightbox-content>
      <img data-lightbox-img alt="" width="1600" height="900" hidden />
      <div class="lightbox__slot" data-lightbox-slot hidden></div>
    </div>
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>

  <button class="lightbox__btn lightbox__btn--close" type="button" data-lightbox-close data-link="photo-close" aria-label={photos.close}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <button class="lightbox__btn lightbox__btn--prev" type="button" data-lightbox-prev data-link="photo-prev" aria-label={photos.prev}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 5-7 7 7 7"></path></svg>
  </button>
  <button class="lightbox__btn lightbox__btn--next" type="button" data-lightbox-next data-link="photo-next" aria-label={photos.next}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 5 7 7-7 7"></path></svg>
  </button>
</dialog>

<script>
  let index = 0;
  let opener: HTMLElement | null = null;
  let group = '';

  const items = () =>
    [...document.querySelectorAll<HTMLElement>('[data-lightbox-item]')].filter(
      (item) => (item.dataset.lightboxGroup ?? '') === group,
    );
  const dialog = () => document.querySelector<HTMLDialogElement>('[data-lightbox]');

  function show(next: number) {
    const list = items();
    const box = dialog();
    if (!box || !list.length) return;
    index = (next + list.length) % list.length;
    const item = list[index]!;
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const slot = box.querySelector<HTMLElement>('[data-lightbox-slot]')!;
    const full = item.dataset.full;

    img.hidden = !full;
    slot.hidden = Boolean(full);
    if (full) {
      img.width = Number(item.dataset.width);
      img.height = Number(item.dataset.height);
      img.alt = item.dataset.alt ?? '';
      img.src = full;
    } else {
      // Фото ще немає: показуємо збільшену заглушку
      const placeholder = item.parentElement?.querySelector('.photo')?.cloneNode(true);
      slot.replaceChildren(...(placeholder ? [placeholder] : []));
    }
    box.querySelector('[data-lightbox-caption]')!.textContent = list.length > 1 ? `${index + 1} / ${list.length}` : '';
    box.classList.toggle('lightbox--single', list.length < 2);
    if (!box.open) box.showModal();
  }

  function close() {
    const box = dialog();
    if (!box?.open) return;
    box.close();
    opener?.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const item = target.closest<HTMLElement>('[data-lightbox-item]');
    if (item) {
      opener = item;
      group = item.dataset.lightboxGroup ?? '';
      show(items().indexOf(item));
      return;
    }
    const box = dialog();
    if (!box?.open || !box.contains(target)) return;
    if (target.closest('[data-lightbox-prev]')) show(index - 1);
    else if (target.closest('[data-lightbox-next]')) show(index + 1);
    else if (target.closest('[data-lightbox-close]') || !target.closest('[data-lightbox-content]')) close();
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog()?.open) return;
    if (event.key === 'ArrowLeft') show(index - 1);
    if (event.key === 'ArrowRight') show(index + 1);
  });

  // Свайпи
  let startX = 0;
  let startY = 0;
  let tracking = false;

  const stage = () => dialog()?.querySelector<HTMLElement>('[data-lightbox-stage]');

  document.addEventListener(
    'touchstart',
    (event) => {
      if (!dialog()?.open || event.touches.length !== 1) return;
      tracking = true;
      startX = event.touches[0]!.clientX;
      startY = event.touches[0]!.clientY;
    },
    { passive: true },
  );

  document.addEventListener(
    'touchmove',
    (event) => {
      const el = stage();
      if (!tracking || !el) return;
      const dx = event.touches[0]!.clientX - startX;
      const dy = event.touches[0]!.clientY - startY;
      const vertical = Math.abs(dy) > Math.abs(dx);
      el.style.transition = 'none';
      el.style.transform = vertical ? `translateY(${dy}px)` : `translateX(${dx}px)`;
      el.style.opacity = String(Math.max(0.3, 1 - Math.abs(vertical ? dy : dx) / 400));
    },
    { passive: true },
  );

  document.addEventListener('touchend', (event) => {
    const el = stage();
    if (!tracking || !el) return;
    tracking = false;
    const dx = event.changedTouches[0]!.clientX - startX;
    const dy = event.changedTouches[0]!.clientY - startY;
    el.style.transition = '';
    el.style.transform = '';
    el.style.opacity = '';
    if (Math.abs(dy) > 80 && Math.abs(dy) > Math.abs(dx)) close();
    else if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
    touch-action: none;
  }

  .lightbox::backdrop {
    background: rgb(15 20 54 / 0.94);
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox__stage {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    gap: var(--s-3);
    height: 100%;
    padding: 4.5rem var(--gutter) var(--s-4);
    transition:
      transform var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease);
  }

  .lightbox[open] .lightbox__stage {
    animation: lightbox-in var(--t-base) var(--ease) both;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .lightbox__content {
    display: grid;
    place-items: center;
    min-height: 0;
    max-height: 100%;
    max-width: min(100%, 75rem);
  }

  .lightbox__content img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 9rem);
    border-radius: var(--r-md);
    object-fit: contain;
  }

  .lightbox__slot {
    width: min(100vw - 2 * var(--gutter), 46rem);
  }

  .lightbox__caption {
    font-size: var(--fs-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #dfe3f5;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    cursor: pointer;
    transition: transform var(--t-fast) var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox__btn:hover {
    transform: scale(1.08);
  }

  .lightbox__btn:active {
    transform: scale(0.94);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--c-pink);
    border-radius: 50%;
  }

  .lightbox__btn--close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox__btn--prev,
  .lightbox__btn--next {
    bottom: 0.75rem;
  }

  .lightbox__btn--prev {
    left: 0.75rem;
  }

  .lightbox__btn--next {
    right: 0.75rem;
  }

  .lightbox--single .lightbox__btn--prev,
  .lightbox--single .lightbox__btn--next {
    display: none;
  }

  @media (min-width: 56.25em) {
    .lightbox__stage {
      padding-inline: 5.5rem;
    }

    .lightbox__btn--prev,
    .lightbox__btn--next {
      top: 50%;
      bottom: auto;
      margin-top: -1.5rem;
    }

    .lightbox__btn--prev {
      left: 1.25rem;
    }

    .lightbox__btn--next {
      right: 1.25rem;
    }
  }
</style>
