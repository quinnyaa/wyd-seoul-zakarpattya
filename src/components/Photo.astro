---
/*
  Фото з автоматичною оптимізацією (WebP, кілька розмірів).
  Якщо файлу ще немає в src/assets/photos/, показує заглушку з підказкою.
*/
import { Picture } from 'astro:assets';
import { getPhoto, type PhotoId } from '../data/photos';

interface Props {
  id: PhotoId;
  /** Підказка браузеру, яку ширину займає фото на екрані. */
  sizes: string;
  widths?: number[];
  /** Пропорції рамки, наприклад '4 / 3'. */
  ratio?: string;
  /** true лише для фото першого екрана: вантажиться одразу й з пріоритетом. */
  priority?: boolean;
  class?: string;
}

const {
  id,
  sizes,
  widths = [400, 640, 800, 1200],
  ratio = '4 / 3',
  priority = false,
  class: className,
} = Astro.props;

const photo = getPhoto(id);
---

<div class:list={['photo', className]} style={`aspect-ratio:${ratio}`}>
  {
    photo.image ? (
      <Picture
        src={photo.image}
        alt={photo.alt}
        formats={['webp']}
        widths={widths}
        sizes={sizes}
        quality={72}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={`Місце для фото: ${photo.alt}`}>
        <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="9" width="38" height="30" rx="5" />
          <circle cx="17" cy="20" r="3.5" />
          <path d="m7 34 10-9 7 6 6-5 11 9" />
        </svg>
        <strong>Місце для фото</strong>
        <span>{photo.hint}</span>
        <code>src/assets/photos/{photo.file}.jpg</code>
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-jade-tint);
  }

  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.375rem;
    padding: var(--s-5);
    text-align: center;
    font-size: var(--fs-xs);
    line-height: 1.45;
    color: var(--c-jade-dark);
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.5) 0 14px, transparent 14px 28px),
      linear-gradient(135deg, var(--c-jade-tint), var(--c-pink-tint));
  }

  .photo__placeholder::before {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 2px dashed rgb(30 106 96 / 0.4);
    border-radius: calc(var(--r-lg) - 0.5rem);
  }

  .photo__placeholder strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--c-indigo-deep);
  }

  .photo__placeholder span {
    max-width: 22rem;
    color: var(--c-ink-soft);
  }

  .photo__placeholder code {
    padding: 0.125rem 0.5rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.75);
    font-size: 1rem;
    color: var(--c-indigo);
    overflow-wrap: anywhere;
  }
</style>
