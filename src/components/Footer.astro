---
import Logo from './Logo.astro';
import Ornament from './Ornament.astro';
import { footer, nav, site } from '../content/texts';
import { url } from '../utils/url';
---

<footer class="footer">
  <Ornament tone="light" size={3} />
  <div class="container footer__grid">
    <div class="footer__about">
      <a class="footer__brand" href={url('/')}>
        <Logo />
        <span>{site.name}</span>
      </a>
      <p>{footer.about}</p>
    </div>

    <nav aria-label={footer.navTitle}>
      <ul class="footer__nav">
        {
          nav.map((item) => (
            <li>
              <a href={url(`/${item.href}`)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer__note">{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-indigo-deep);
    color: #dfe3f5;
    font-size: var(--fs-sm);
  }

  .footer__grid {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-7);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    margin-bottom: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  .footer__about p {
    max-width: 26rem;
  }

  .footer__nav {
    display: grid;
    margin: 0;
  }

  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }

  .footer__nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .footer__note {
    max-width: 24rem;
    color: #b9c0e0;
  }

  /* Місце під закріплену кнопку «Допомогти» на мобільному */
  @media (max-width: 56.24em) {
    .footer {
      padding-bottom: calc(var(--sticky-h) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (min-width: 56.25em) {
    .footer__grid {
      grid-template-columns: 1.4fr 0.8fr 1.2fr;
      gap: var(--s-8);
    }

    /* Вирівнюємо примітку з першим рядком навігації */
    .footer__note {
      padding-top: 0.5rem;
    }
  }
</style>
