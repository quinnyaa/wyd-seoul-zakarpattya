---
import ExternalIcon from './ExternalIcon.astro';
import Logo from './Logo.astro';
import Ornament from './Ornament.astro';
import { useI18n } from '../utils/i18n';

const { lang, t, link } = useI18n(Astro);
const { footer, nav, site } = t;
// Рядки внизу можуть бути іншою мовою, ніж сторінка (зараз — англійською)
const legalLang = footer.legalLang === lang ? undefined : footer.legalLang;
---

<footer class="footer">
  <Ornament tone="light" size={3} />
  <div class="container footer__grid">
    <div class="footer__about">
      <a class="footer__brand" href={link('/')}>
        <Logo />
        <span>{site.name}</span>
      </a>
      <p>{footer.about}</p>
    </div>

    <nav aria-label={footer.navTitle}>
      <ul class="footer__nav">
        {
          nav.map((item) => (
            <li>
              <a href={link(`/${item.href}`)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer__note">{footer.disclaimer}</p>
  </div>
  <div class="container footer__legal">
    <p lang={legalLang}>
      {footer.privacy}
      <a href={footer.sourceHref} target="_blank" rel="noopener noreferrer">
        {footer.sourceLabel}<ExternalIcon />
      </a>
    </p>
    <p lang={legalLang}>{footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-indigo-deep);
    color: #dfe3f5;
    font-size: var(--fs-sm);
  }

  .footer__grid {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-7);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    margin-bottom: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  .footer__about p {
    max-width: 26rem;
  }

  .footer__nav {
    display: grid;
    margin: 0;
  }

  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }

  .footer__nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .footer__note {
    max-width: 24rem;
    color: #b9c0e0;
  }

  .footer__legal {
    padding-block: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.875rem;
    text-align: center;
    color: #b9c0e0;
  }

  .footer__legal p {
    margin-inline: auto;
  }

  .footer__legal a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    margin-left: 0.5rem;
    color: #fff;
  }

  /* Місце під закріплену кнопку «Допомогти» (вона є, поки в шапці меню-бургер) */
  @media (max-width: 63.99em) {
    .footer {
      padding-bottom: calc(var(--sticky-h) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (min-width: 56.25em) {
    .footer__grid {
      grid-template-columns: 1.4fr 0.8fr 1.2fr;
      gap: var(--s-8);
    }

    /* Вирівнюємо примітку з першим рядком навігації */
    .footer__note {
      padding-top: 0.5rem;
    }
  }
</style>
