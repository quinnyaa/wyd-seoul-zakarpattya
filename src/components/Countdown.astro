---
import { hero, site } from '../content/texts';
import { plural, timeLeft } from '../utils/countdown';

const { countdown } = hero;
const target = new Date(site.eventStart).getTime();
// Початкові значення на момент збирання сайту; далі їх щосекунди оновлює скрипт
const initial = timeLeft(target, Date.now());
const units = ['days', 'hours', 'minutes', 'seconds'] as const;
---

<div class="countdown" data-countdown data-target={target} data-forms={JSON.stringify(countdown.units)}>
  <h2 class="countdown__title">{countdown.title}</h2>
  <div class="countdown__grid" role="timer" data-countdown-grid hidden={initial.done}>
    {
      units.map((unit) => (
        <div class="countdown__unit">
          <span class="countdown__num" data-num={unit}>
            {unit === 'days' ? initial[unit] : String(initial[unit]).padStart(2, '0')}
          </span>
          <span class="countdown__label" data-label={unit}>
            {plural(initial[unit], countdown.units[unit])}
          </span>
        </div>
      ))
    }
  </div>
  <p class="countdown__done" data-countdown-done hidden={!initial.done}>{countdown.done}</p>
</div>

<script>
  import { plural, timeLeft, type Forms } from '../utils/countdown';

  const units = ['days', 'hours', 'minutes', 'seconds'] as const;
  let timer: number | undefined;

  function initCountdown() {
    const root = document.querySelector<HTMLElement>('[data-countdown]');
    if (!root) return;

    const target = Number(root.dataset.target);
    const forms = JSON.parse(root.dataset.forms ?? '{}') as Record<string, Forms>;
    const grid = root.querySelector<HTMLElement>('[data-countdown-grid]');
    const done = root.querySelector<HTMLElement>('[data-countdown-done]');
    const set = (el: Element | null, text: string) => {
      if (el && el.textContent !== text) el.textContent = text;
    };

    const tick = () => {
      const left = timeLeft(target, Date.now());
      if (grid) grid.hidden = left.done;
      if (done) done.hidden = !left.done;
      if (left.done) {
        window.clearInterval(timer);
        return;
      }
      for (const unit of units) {
        const value = left[unit];
        set(
          root.querySelector(`[data-num="${unit}"]`),
          unit === 'days' ? String(value) : String(value).padStart(2, '0'),
        );
        set(root.querySelector(`[data-label="${unit}"]`), plural(value, forms[unit]));
      }
    };

    tick();
    timer = window.setInterval(tick, 1000);
  }

  initCountdown();
</script>

<style>
  .countdown {
    text-align: center;
  }

  .countdown__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: #dfe3f5;
  }

  .countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
    max-width: 46rem;
    margin: var(--s-5) auto 0;
  }

  .countdown__grid[hidden] {
    display: none;
  }

  .countdown__unit {
    display: grid;
    gap: 0.25rem;
    padding: var(--s-4) var(--s-1);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .countdown__num {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 0.6rem + 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .countdown__unit:first-child .countdown__num {
    color: var(--c-pink);
  }

  .countdown__label {
    font-size: 1rem;
    font-weight: 600;
    color: #c9cfea;
  }

  .countdown__done {
    max-width: 36rem;
    margin: var(--s-5) auto 0;
    font-size: var(--fs-lg);
    color: #fff;
  }

  @media (min-width: 48em) {
    .countdown__grid {
      gap: var(--s-4);
    }

    .countdown__unit {
      padding-block: var(--s-5);
    }

    .countdown__label {
      font-size: var(--fs-sm);
    }
  }
</style>
