---
/*
  Відео з YouTube. Спершу лише локальна обкладинка: плеєр YouTube вантажиться
  тільки після натискання, тож до того сайт нічого не тягне з Google.
  Домен youtube-nocookie.com — без cookies, доки людина не запустить відео.
*/
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useI18n } from '../utils/i18n';

interface Props {
  /** Ідентифікатор відео з адреси YouTube (watch?v=…). */
  id: string;
  title: string;
  play: string;
  poster: ImageMetadata;
}

const { id, title, play, poster } = Astro.props;
const { lang } = useI18n(Astro);

const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&hl=${lang}`;
---

<div class="video" data-video={src} data-video-title={title}>
  <button class="video__play" type="button" data-link="video-pope" aria-label={`${play}: ${title}`}>
    <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 60em) 56rem, calc(100vw - 2rem)" />
    <span class="video__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M8 5.5v13l10.5-6.5L8 5.5Z"></path></svg>
    </span>
  </button>
  <noscript>
    <a class="video__fallback" href={`https://www.youtube.com/watch?v=${id}`}>{play}</a>
  </noscript>
</div>

<script>
  // Замінюємо обкладинку на плеєр лише після натискання
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest('.video__play');
    const box = button?.closest<HTMLElement>('[data-video]');
    if (!box) return;

    const frame = document.createElement('iframe');
    frame.src = box.dataset.video!;
    frame.title = box.dataset.videoTitle ?? '';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.allowFullscreen = true;
    box.replaceChildren(frame);
    frame.focus();
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-indigo-deep);
    box-shadow: var(--shadow-md);
  }

  .video :global(iframe),
  .video__play,
  .video__play img {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__play {
    padding: 0;
    background: none;
    cursor: pointer;
  }

  .video__play img {
    object-fit: cover;
    transition: transform var(--t-base) var(--ease);
  }

  .video__icon {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--c-red);
    color: #fff;
    box-shadow: var(--shadow-lg);
    transform: translate(-50%, -50%);
    transition: background var(--t-base) var(--ease), transform var(--t-base) var(--ease);
  }

  .video__icon svg {
    margin-left: 0.25rem;
  }

  .video__play:hover img {
    transform: scale(1.02);
  }

  .video__play:hover .video__icon,
  .video__play:focus-visible .video__icon {
    background: var(--c-red-dark);
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video__play:focus-visible {
    outline-offset: -0.25rem;
  }

  .video__fallback {
    position: absolute;
    inset: auto 0 0;
    padding: var(--s-3);
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    text-align: center;
  }
</style>
