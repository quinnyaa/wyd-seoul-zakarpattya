---
/*
  Кнопка «Багато різних сертифікатів» у списку подарунків.
  Розгортає панель сертифікатів (Certificates.astro), що стоїть під списком на всю ширину.
*/
import { useI18n } from '../utils/i18n';

interface Props {
  /** Скільки сертифікатів у панелі — показуємо на кружечку. */
  count: number;
}

const { count } = Astro.props;
const { certificates } = useI18n(Astro).t.gifts;
---

<button class="certs-toggle" type="button" aria-expanded="false" aria-controls="certs-panel" data-certs-toggle data-link="certificates">
  <span class="certs-toggle__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5V10a2 2 0 0 0 0 4v2.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5V14a2 2 0 0 0 0-4z" />
      <path d="M15 6v2M15 11v2M15 16v2" />
    </svg>
    <span class="certs-toggle__count">{count}</span>
  </span>
  <span class="certs-toggle__text">
    {certificates.toggle}
    <small>{certificates.hint}</small>
  </span>
  <span class="certs-toggle__chevron" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-certs-toggle]').forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute('aria-controls')!);
    if (!panel) return;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('certs--open', open);
      panel.inert = !open;
    });
  });
</script>

<style>
  .certs-toggle {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    width: 100%;
    padding: 0.75rem 0.75rem 0.75rem 0.75rem;
    border: 0;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, rgb(226 177 94 / 0.2), rgb(226 177 94 / 0.08));
    box-shadow: inset 0 0 0 1.5px rgb(226 177 94 / 0.55);
    font: inherit;
    font-weight: 700;
    line-height: 1.35;
    text-align: start;
    color: #fff;
    cursor: pointer;
    transition:
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease),
      background var(--t-fast) var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .certs-toggle:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, rgb(226 177 94 / 0.28), rgb(226 177 94 / 0.12));
    box-shadow:
      inset 0 0 0 1.5px var(--c-gold),
      0 14px 30px rgb(5 8 30 / 0.35);
  }

  .certs-toggle:active {
    transform: translateY(0) scale(0.99);
  }

  .certs-toggle:focus-visible {
    outline-color: var(--c-gold-light);
  }

  .certs-toggle__icon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-gold-light), var(--c-gold));
    color: var(--c-indigo-deep);
  }

  .certs-toggle__text {
    display: grid;
    flex: 1;
    gap: 0.125rem;
  }

  .certs-toggle__text small {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-gold-light);
  }

  /* Кількість — кружечком у куточку іконки, щоб на телефоні лишалося місце для тексту */
  .certs-toggle__count {
    position: absolute;
    top: -0.375rem;
    right: -0.5rem;
    display: grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding-inline: 0.3125rem;
    box-shadow: 0 0 0 2px var(--c-indigo-deep);
    border-radius: var(--r-pill);
    background: var(--c-red);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .certs-toggle__chevron {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--c-gold-light);
    transition: transform var(--t-base) var(--ease);
  }

  .certs-toggle[aria-expanded='true'] .certs-toggle__chevron {
    transform: rotate(180deg);
  }
</style>
