---
/* Текст із позначками **жирний** і [посилання](адреса) — див. src/content/texts/uk.ts. */
import ExternalIcon from './ExternalIcon.astro';
import { isExternal, parseRich } from '../utils/rich';
import { useI18n } from '../utils/i18n';

interface Props {
  text: string;
}

const { link } = useI18n(Astro);
const parts = parseRich(Astro.props.text);
---

{
  parts.map((part) =>
    part.type === 'strong' ? (
      <strong>{part.text}</strong>
    ) : part.type === 'link' ? (
      isExternal(part.href) ? (
        <a class="text-link" href={part.href} target="_blank" rel="noopener noreferrer">{part.text}<ExternalIcon /></a>
      ) : (
        <a class="text-link" href={link(part.href)}>{part.text}</a>
      )
    ) : (
      part.text
    ),
  )
}
