---
/* Секція «Наша подяка»: Паломницька листівка, правило «кожні 200 грн — одна листівка», Вечір подяки і місце для макета. */
import CardMockup from './CardMockup.astro';
import Ornament from './Ornament.astro';
import Rich from './Rich.astro';
import { useI18n } from '../utils/i18n';

const { thanks } = useI18n(Astro).t;
---

<section class="thanks" id="thanks" tabindex="-1" aria-labelledby="thanks-title">
  <Ornament />
  <div class="container thanks__grid section">
    <div class="stack reveal">
      <span class="eyebrow">{thanks.eyebrow}</span>
      <h2 id="thanks-title">{thanks.title}</h2>
      <p class="thanks__intro">{thanks.intro}</p>
      <p><Rich text={thanks.text} /></p>
      <p class="thanks__rule">{thanks.rule}</p>
      <p><Rich text={thanks.evening} /></p>
    </div>
    <div class="reveal" style="--i:1">
      <CardMockup />
    </div>
  </div>
</section>

<style>
  .thanks {
    background: var(--c-pink-tint);
  }

  .thanks__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  .thanks__intro {
    font-size: var(--fs-lg);
    font-style: italic;
    color: var(--c-ink-soft);
  }

  .thanks__rule {
    display: inline-block;
    padding: 0.5rem 1.125rem;
    border-radius: var(--r-lg);
    background: var(--c-indigo);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }

  .thanks :global(strong) {
    font-weight: 800;
    color: var(--c-indigo-deep);
  }

  @media (min-width: 56.25em) {
    .thanks__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--s-8);
    }
  }
</style>
