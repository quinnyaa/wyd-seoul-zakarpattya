---
import Arrow from './Arrow.astro';
import Logo from './Logo.astro';
import { nav, site } from '../content/texts';
import { url } from '../utils/url';
---

<header class="header">
  <div class="header__bar container">
    <a class="header__brand" href={url('/')} aria-label={`${site.name} — ${site.homeLabel}`}>
      <Logo />
      <span>{site.name}</span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={site.menu.open}
      data-menu-toggle
      data-link="menu"
      data-label-open={site.menu.open}
      data-label-close={site.menu.close}
    >
      <span class="header__burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav class="menu" id="site-menu" aria-label={site.menu.label}>
      <div class="menu__panel">
        <ul class="menu__list">
          {
            nav.map((item, i) => (
              <li style={`--i:${i}`}>
                <a class="menu__link" href={url(`/${item.href}`)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--primary menu__help" href={url('/#help')}>
          {site.helpButton}
          <Arrow />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;

  function setMenu(open: boolean, returnFocus = false) {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '',
    );
    root.classList.toggle('menu-open', open);
    document.querySelectorAll('main, footer, .sticky-help').forEach((el) => {
      el.toggleAttribute('inert', open);
    });
    if (returnFocus) toggle.focus();
  }

  const isOpen = () => root.classList.contains('menu-open');

  /** Секція цієї сторінки, на яку веде посилання меню (на сторінці 404 таких немає). */
  function sectionOf(link: HTMLAnchorElement) {
    if (!link.hash || link.pathname !== location.pathname) return null;
    return document.getElementById(decodeURIComponent(link.hash.slice(1)));
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-menu-toggle]')) {
      setMenu(!isOpen());
      return;
    }
    const link = target.closest<HTMLAnchorElement>('#site-menu a');
    if (isOpen() && (link || !target.closest('.menu__panel'))) {
      // Клік по пункту меню або поза меню
      setMenu(false);
    }
    // Після переходу з меню фокус стає на секцію, щоб клавіатура й екранний читач продовжили з неї
    const section = link && sectionOf(link);
    if (section) requestAnimationFrame(() => section.focus({ preventScroll: true }));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) setMenu(false, true);
  });

  // Під час скролу підсвічуємо пункт меню тієї секції, яка зараз на екрані
  function initScrollSpy() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.menu__link')];
    const sections = new Map<Element, HTMLAnchorElement>();
    for (const link of links) {
      const section = sectionOf(link);
      if (section) sections.set(section, link);
    }
    if (!sections.size || !('IntersectionObserver' in window)) return;

    const onScreen = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        // Активна та секція, яка перетинає лінію трохи вище середини екрана
        const current = [...sections.keys()].find((section) => onScreen.has(section));
        for (const [section, link] of sections) {
          if (section === current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-40% 0px -60% 0px' },
    );
    sections.forEach((_, section) => observer.observe(section));
  }

  initScrollSpy();

  // Якщо екран розширили до десктопного, закриваємо мобільне меню
  window.matchMedia('(min-width: 56.25em)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* Фон шапки окремим шаром, щоб повноекранне меню позиціонувалося від вікна */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(251 245 236 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-line);
  }

  .header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: var(--header-h);
  }

  .header__brand {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--c-indigo-deep);
    text-decoration: none;
  }

  .header__toggle {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-sm);
    background: none;
    color: var(--c-indigo-deep);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 1.5rem;
  }

  .header__burger i {
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform var(--t-base) var(--ease),
      opacity var(--t-fast) var(--ease);
  }

  :global(.menu-open) .header__burger i:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }

  :global(.menu-open) .header__burger i:nth-child(2) {
    opacity: 0;
  }

  :global(.menu-open) .header__burger i:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* ----- Мобільне повноекранне меню ----- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + var(--s-6)) var(--gutter) var(--s-6);
    background: var(--c-bg);
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.75rem);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease),
      visibility 0s linear var(--t-base);
  }

  :global(.menu-open) .menu {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  .menu__panel {
    display: grid;
    gap: var(--s-6);
  }

  .menu__list {
    display: grid;
    margin: 0;
  }

  .menu__link {
    display: flex;
    align-items: center;
    min-height: 4rem;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--c-indigo-deep);
    text-decoration: none;
  }

  .menu__link[aria-current] {
    color: var(--c-red-dark);
  }

  .menu__help {
    min-height: 3.5rem;
    font-size: 1.0625rem;
  }

  /* ----- Десктоп ----- */

  @media (min-width: 56.25em) {
    .header__brand {
      font-size: 1rem;
    }

    .header__toggle {
      display: none;
    }

    .menu {
      position: static;
      flex-direction: row;
      padding: 0;
      background: none;
      overflow: visible;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .menu__panel {
      display: flex;
      align-items: center;
      gap: var(--s-5);
    }

    .menu__list {
      display: flex;
      gap: var(--s-1);
    }

    .menu__link {
      position: relative;
      min-height: 2.75rem;
      padding-inline: 0.875rem;
      border: 0;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 700;
    }

    .menu__link::after {
      content: '';
      position: absolute;
      left: 0.875rem;
      right: 0.875rem;
      bottom: 0.5rem;
      height: 2px;
      border-radius: 2px;
      background: var(--c-red);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--t-base) var(--ease);
    }

    .menu__link:hover::after,
    .menu__link[aria-current]::after {
      transform: scaleX(1);
    }

    .menu__help {
      min-height: 2.75rem;
      font-size: 1rem;
    }
  }
</style>
