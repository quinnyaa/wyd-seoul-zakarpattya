---
/* Червона панель з орнаментом: головний заклик секції «Як допомогти». */
import Arrow from './Arrow.astro';
import Ornament from './Ornament.astro';
import Rich from './Rich.astro';
import { url } from '../utils/url';

interface Props {
  eyebrow: string;
  title: string;
  /** id заголовка — щоб секція могла послатися на нього через aria-labelledby. */
  titleId?: string;
  /** Абзаци; у них працюють позначки **жирний** і [посилання](адреса). */
  text: string[];
  button: string;
  href: string;
}

const { eyebrow, title, titleId, text, button, href } = Astro.props;
---

<div class="cta reveal">
  <Ornament tone="light" size={3} />
  <div class="cta__body">
    <p class="cta__eyebrow">{eyebrow}</p>
    <h2 id={titleId}>{title}</h2>
    {text.map((paragraph) => <p class="cta__text"><Rich text={paragraph} /></p>)}
    <a class="btn btn--light btn--lg" href={url(href)} data-sticky-hide>
      {button}
      <Arrow />
    </a>
  </div>
</div>

<style>
  .cta {
    border-radius: var(--r-xl);
    background: var(--c-red);
    color: #fff;
    text-align: center;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .cta__body {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-5) var(--s-7);
  }

  .cta__eyebrow {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cta__text {
    max-width: 40rem;
    font-size: var(--fs-lg);
  }

  .cta__text :global(strong) {
    font-weight: 800;
  }

  .cta__body .btn {
    margin-top: var(--s-2);
  }

  @media (min-width: 48em) {
    .cta__body {
      padding: var(--s-7) var(--s-7) var(--s-8);
    }
  }
</style>
