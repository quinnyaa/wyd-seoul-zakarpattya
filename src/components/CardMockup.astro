---
/*
  Макет Паломницької листівки: файл card.png (або .jpg, .webp) у src/assets/card/.
  Пропорції рамки беруться з самого файлу. Поки файлу немає, показується заглушка формату A6.
  Клік по листівці відкриває її збільшеною в Lightbox (він підключений у PhotoGrid на цій же сторінці).
*/
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ornament from './Ornament.astro';
import { site, thanks } from '../content/texts';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/card/card.{png,jpg,jpeg,webp,PNG,JPG,JPEG,WEBP}',
  { eager: true },
);
const image = Object.values(files)[0]?.default;
const { mockup } = thanks;

// На листівці дрібний текст, тож для збільшеного перегляду якість вища, ніж у фото
const full = image && (await getImage({ src: image, width: Math.min(2400, image.width), format: 'webp', quality: 85 }));
const ratio = image ? `${image.width} / ${image.height}` : '148 / 105';
// Широка листівка (як двостороння смужка) лягає на всю ширину колонки і майже без нахилу
const wide = image ? image.width / image.height > 2 : false;
---

<div class:list={['mockup', { 'mockup--wide': wide }]} style={`--ratio:${ratio}`}>
  <div class="mockup__card mockup__card--back" aria-hidden="true"></div>
  <div class="mockup__card mockup__card--front">
    {
      image && full ? (
        <>
          <Image
            src={image}
            alt={mockup.alt}
            widths={[400, 640, 900, 1300, 1800]}
            sizes="(min-width: 56.25em) 34rem, calc(100vw - 2rem)"
            format="webp"
            quality={82}
          />
          <button
            class="mockup__open"
            type="button"
            data-lightbox-item
            data-lightbox-group="card"
            data-link="card-open"
            data-full={full.src}
            data-width={full.attributes.width}
            data-height={full.attributes.height}
            data-alt={mockup.alt}
            aria-label={`Збільшити: ${mockup.alt}`}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" />
            </svg>
          </button>
        </>
      ) : (
        <div class="mockup__placeholder" role="img" aria-label={`${mockup.note}. ${mockup.thanks} ${site.name}`}>
          <Ornament size={3} />
          <div class="mockup__body">
            <p class="mockup__thanks">{mockup.thanks}</p>
            <p class="mockup__name">{site.name}</p>
          </div>
          <p class="mockup__note">{mockup.note}</p>
        </div>
      )
    }
  </div>
</div>

<style>
  .mockup {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
    padding: 1.25rem 0.75rem 1.5rem;
  }

  .mockup--wide {
    width: 100%;
    padding: 1rem 0.5rem 1.25rem;
  }

  .mockup__card {
    aspect-ratio: var(--ratio);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: transform var(--t-base) var(--ease);
  }

  .mockup__card--back {
    position: absolute;
    inset: 1.25rem 0.75rem auto;
    background: var(--c-indigo);
    transform: rotate(6deg) translate(4%, 4%);
  }

  .mockup__card--front {
    position: relative;
    background: var(--c-surface);
    box-shadow: var(--shadow-lg);
    transform: rotate(-3deg);
  }

  .mockup:hover .mockup__card--front {
    transform: rotate(-1deg) translateY(-4px);
  }

  .mockup:hover .mockup__card--back {
    transform: rotate(8deg) translate(5%, 5%);
  }

  /* У широкої картки той самий кут дав би завеликий перекіс по краях */
  .mockup--wide .mockup__card--back {
    inset: 1rem 0.5rem auto;
    transform: rotate(2.5deg) translate(1.5%, 6%);
  }

  .mockup--wide .mockup__card--front {
    transform: rotate(-1.5deg);
  }

  .mockup--wide:hover .mockup__card--front {
    transform: rotate(-0.5deg) translateY(-4px);
  }

  .mockup--wide:hover .mockup__card--back {
    transform: rotate(3.5deg) translate(2%, 8%);
  }

  .mockup__card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mockup__open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end;
    width: 100%;
    padding: 0.625rem;
    border: 0;
    border-radius: inherit;
    background: none;
    color: #fff;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }

  .mockup__open:focus-visible {
    outline-offset: -4px;
    border-radius: var(--r-md);
  }

  .mockup__open svg {
    box-sizing: content-box;
    padding: 0.5rem;
    border-radius: 50%;
    background: rgb(20 27 71 / 0.72);
    transition: transform var(--t-fast) var(--ease);
  }

  .mockup__open:hover svg {
    transform: scale(1.12);
  }

  .mockup__open:active svg {
    transform: scale(0.92);
  }

  .mockup__placeholder {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding: 0.875rem 1rem 0.75rem;
    text-align: center;
  }

  .mockup__body {
    display: grid;
    align-content: center;
    gap: 0.25rem;
  }

  .mockup__thanks {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 6.4vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--c-red);
  }

  .mockup__name {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-indigo);
  }

  .mockup__note {
    justify-self: center;
    padding: 0.125rem 0.75rem;
    border: 1.5px dashed var(--c-indigo-mid);
    border-radius: var(--r-pill);
    font-size: 1rem;
    color: var(--c-ink-soft);
  }
</style>
