---
/* Картка контактної особи: телефон і кнопки месенджерів. Дані — у src/data/contacts.ts. */
import ExternalIcon from './ExternalIcon.astro';
import { contacts as texts } from '../content/texts';
import { formatPhone, links, type Contact } from '../data/contacts';
import { isExternal } from '../utils/rich';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;

const channels = [
  {
    id: 'viber',
    label: 'Viber',
    href: links.viber(contact),
    icon: 'M6.5 4h2.5l1.5 4-2 1.5a10 10 0 0 0 5 5l1.5-2 4 1.5v2.5a2 2 0 0 1-2 2C10.5 18.5 5 13 4.5 6a2 2 0 0 1 2-2ZM14 4.5a5.5 5.5 0 0 1 5.5 5.5M14 7.5a2.5 2.5 0 0 1 2.5 2.5',
  },
  {
    id: 'telegram',
    label: 'Telegram',
    href: links.telegram(contact),
    icon: 'M21 4 3 11.2l5.6 2.1L11 20l3.1-4.4 4.4 3.2ZM8.6 13.3 17 7.5',
  },
].flatMap((channel) => (channel.href ? [{ ...channel, href: channel.href }] : []));
---

<article class="contact" data-contact={contact.name}>
  <header>
    <h3 class="contact__name">{contact.name}</h3>
    {contact.role && <p class="contact__role">{contact.role}</p>}
  </header>

  <a class="contact__phone" href={links.tel(contact)} data-link="tel">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6.5 4h2.5l1.5 4-2 1.5a10 10 0 0 0 5 5l1.5-2 4 1.5v2.5a2 2 0 0 1-2 2C10.5 18.5 5 13 4.5 6a2 2 0 0 1 2-2Z"></path>
    </svg>
    <span class="contact__call">
      <strong>{texts.callLabel}</strong>
      <span>{formatPhone(contact.phone)}</span>
    </span>
  </a>

  <ul class="contact__channels">
    {
      channels.map((channel) => (
        <li>
          <a
            class={`contact__channel contact__channel--${channel.id}`}
            href={channel.href}
            data-link={channel.id}
            {...(isExternal(channel.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={channel.icon} />
            </svg>
            <span>{channel.label}{isExternal(channel.href) && <ExternalIcon />}</span>
          </a>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .contact {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--t-base) var(--ease);
  }

  .contact:hover {
    transform: translateY(-4px);
  }

  .contact__name {
    color: var(--c-indigo-deep);
    overflow-wrap: anywhere;
  }

  .contact__role {
    margin-top: 0.25rem;
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  .contact__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 4rem;
    padding: 0.625rem 1rem;
    border-radius: var(--r-md);
    background: var(--c-indigo);
    color: #fff;
    text-decoration: none;
    transition: transform var(--t-fast) var(--ease);
  }

  .contact__call {
    display: grid;
    line-height: 1.3;
  }

  .contact__call strong {
    font-size: 1.125rem;
    font-weight: 800;
  }

  .contact__call span {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: #dfe3f5;
  }

  .contact__phone:hover {
    transform: translateY(-2px);
  }

  .contact__phone:active,
  .contact__channel:active {
    transform: scale(0.97);
  }

  .contact__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
    margin: 0;
  }

  .contact__channel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.5rem;
    border-radius: var(--r-md);
    background: var(--c-indigo-tint);
    color: var(--c-indigo-deep);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--t-fast) var(--ease);
  }

  .contact__channel:hover {
    transform: translateY(-2px);
  }

  .contact__channel--viber {
    background: var(--c-pink-tint);
  }
</style>
