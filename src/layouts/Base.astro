---
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import manropeLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import unboundedCyr from '@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import unboundedLat from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import Arrow from '../components/Arrow.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { hero, site } from '../content/texts';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** true, якщо вгорі сторінки вже є така сама кнопка (позначена data-sticky-hide). */
  stickyStartsHidden?: boolean;
  /** true для службових сторінок (404), яким не місце в пошуку. */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  stickyStartsHidden = false,
  noindex = false,
} = Astro.props;

// Для прев’ю в месенджерах — окремі короткі тексти, якщо сторінка не задала свої
const shareTitle = Astro.props.title ?? site.shareTitle;
const shareDescription = Astro.props.description ?? site.shareDescription;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.jpg'), Astro.site);

// Лише кирилиця й латиниця, варіативні файли (усі потрібні накреслення в одному файлі)
const CYRILLIC = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, weight: string, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2-variations');unicode-range:${range}}`;
const fontCss = [
  face('Manrope Variable', '200 800', manropeCyr, CYRILLIC),
  face('Manrope Variable', '200 800', manropeLat, LATIN),
  face('Unbounded Variable', '200 900', unboundedCyr, CYRILLIC),
  face('Unbounded Variable', '200 900', unboundedLat, LATIN),
  // Запасні шрифти з підігнаною шириною, щоб текст не стрибав, поки вантажаться основні
  `@font-face{font-family:'Manrope Fallback';src:local('Arial');size-adjust:104%;ascent-override:102%;descent-override:29%;line-gap-override:0%}`,
  `@font-face{font-family:'Unbounded Fallback';src:local('Arial');size-adjust:129%;ascent-override:83%;descent-override:20%;line-gap-override:0%}`,
].join('');
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf5ec" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${hero.eventLine.join(' · ')}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={manropeCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={unboundedCyr} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      class:list={['btn btn--primary sticky-help', { 'is-hidden': stickyStartsHidden }]}
      href={url('/#help')}
    >
      {site.helpButton}
      <Arrow />
    </a>

    <script>
      // Поява блоків при скролі
      function initReveal() {
        const items = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => observer.observe(el));
      }

      // Закріплена кнопка ховається, поки на екрані видно елементи з data-sticky-hide:
      // таку саму кнопку в тексті або секції «Як допомогти» й «Контакти»
      function initSticky() {
        const bar = document.querySelector('.sticky-help');
        const targets = document.querySelectorAll('[data-sticky-hide]');
        if (!bar) return;
        if (!targets.length || !('IntersectionObserver' in window)) {
          bar.classList.remove('is-hidden');
          return;
        }
        const visible = new Set<Element>();
        // Те, що сховане під шапкою, видимим не вважаємо (+1 px: край, що лише торкається шапки, теж не рахуємо)
        const header = (document.querySelector<HTMLElement>('.header')?.offsetHeight ?? 0) + 1;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
            }
            bar.classList.toggle('is-hidden', visible.size > 0);
          },
          { rootMargin: `-${header}px 0px 0px 0px` },
        );
        targets.forEach((el) => observer.observe(el));
      }

      // Лічильник кліків по всіх посиланнях і кнопках. Надсилає, що натиснули (data-link або адресу),
      // де на сторінці, підпис і ім’я з картки контакту — і нічого про людину. Далі functions/api/click.ts
      function initClicks() {
        if (!('sendBeacon' in navigator)) return;
        const placeOf = (el: Element) => {
          if (el.closest('dialog')) return 'lightbox';
          if (el.closest('.sticky-help')) return 'sticky';
          if (el.closest('.header')) return 'header';
          if (el.closest('.footer')) return 'footer';
          return el.closest('section[id]')?.id ?? '';
        };
        // capture: клік зарахується, навіть якщо інший обробник зупинить його поширення
        document.addEventListener(
          'click',
          (e) => {
            const el = (e.target as Element | null)?.closest<HTMLElement>('a[href], button');
            if (!el) return;
            const label = (el.getAttribute('aria-label') ?? el.textContent ?? '').replace(/\s+/g, ' ').trim();
            const contact = el.closest<HTMLElement>('[data-contact]')?.dataset.contact ?? '';
            const link = el.dataset.link ?? el.getAttribute('href') ?? 'button';
            navigator.sendBeacon('/api/click', JSON.stringify({ link, place: placeOf(el), label, contact }));
          },
          true,
        );
      }

      initSticky();
      initReveal();
      initClicks();
    </script>
  </body>
</html>

<style>
  /* Кнопка «Допомогти», закріплена внизу екрана на мобільному */
  .sticky-help {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    min-height: 3.25rem;
    box-shadow: var(--shadow-lg);
    transition:
      transform var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease),
      visibility 0s;
  }

  :global(.js) .sticky-help.is-hidden {
    visibility: hidden;
    opacity: 0;
    transform: translateY(150%);
    transition-delay: 0s, 0s, var(--t-base);
  }

  @media (min-width: 56.25em) {
    .sticky-help {
      display: none;
    }
  }
</style>
