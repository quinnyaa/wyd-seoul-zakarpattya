---
import { existsSync } from 'node:fs';
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import manropeLat from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeLatExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import unboundedCyr from '@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import unboundedLat from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import unboundedLatExt from '@fontsource-variable/unbounded/files/unbounded-latin-ext-wght-normal.woff2?url';
import Arrow from '../components/Arrow.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { alternates, defaultLang, useI18n } from '../utils/i18n';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** true, якщо вгорі сторінки вже є така сама кнопка (позначена data-sticky-hide). */
  stickyStartsHidden?: boolean;
  /** true для службових сторінок (404), яким не місце в пошуку. */
  noindex?: boolean;
}

const { lang, t, link } = useI18n(Astro);
const { hero, site } = t;

const {
  title = site.title,
  description = site.description,
  stickyStartsHidden = false,
  noindex = false,
} = Astro.props;

// Для прев’ю в месенджерах — окремі короткі тексти, якщо сторінка не задала свої
const shareTitle = Astro.props.title ?? site.shareTitle;
const shareDescription = Astro.props.description ?? site.shareDescription;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Картинка для соцмереж своя для кожної мови (public/og-en.jpg…), поки її немає — основною мовою
const ogFile = lang !== defaultLang && existsSync(`public/og-${lang}.jpg`) ? `/og-${lang}.jpg` : '/og.jpg';
const ogImage = new URL(url(ogFile), Astro.site);

// Ця сторінка іншими мовами: для перемикача в шапці й підказки пошуковикам (hreflang).
// У 404 перекладів за тією ж адресою немає, тож перемикач веде на головні
const languages = alternates(Astro.url, noindex);
const language = languages.find((item) => item.code === lang)!;
const translated = languages.length > 1 && !noindex;

// Лише кирилиця й латиниця, варіативні файли (усі потрібні накреслення в одному файлі).
// Розширена латиниця (ž в «Užhorod») вантажиться, лише якщо такі літери є на сторінці.
// Для інших абеток (грецька, грузинська…) треба додати їхні файли шрифтів.
const CYRILLIC = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (family: string, weight: string, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2-variations');unicode-range:${range}}`;
const fontCss = [
  face('Manrope Variable', '200 800', manropeCyr, CYRILLIC),
  face('Manrope Variable', '200 800', manropeLat, LATIN),
  face('Manrope Variable', '200 800', manropeLatExt, LATIN_EXT),
  face('Unbounded Variable', '200 900', unboundedCyr, CYRILLIC),
  face('Unbounded Variable', '200 900', unboundedLat, LATIN),
  face('Unbounded Variable', '200 900', unboundedLatExt, LATIN_EXT),
  // Запасні шрифти з підігнаною шириною, щоб текст не стрибав, поки вантажаться основні
  `@font-face{font-family:'Manrope Fallback';src:local('Arial');size-adjust:104%;ascent-override:102%;descent-override:29%;line-gap-override:0%}`,
  `@font-face{font-family:'Unbounded Fallback';src:local('Arial');size-adjust:129%;ascent-override:83%;descent-override:20%;line-gap-override:0%}`,
].join('');
// Наперед вантажимо шрифти тієї абетки, якою написана сторінка
const cyrillic = /[\u0400-\u04ff]/.test(site.name + site.title);
const preload = cyrillic ? [manropeCyr, unboundedCyr] : [manropeLat, unboundedLat];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      translated && [
        ...languages.map((item) => <link rel="alternate" hreflang={item.code} href={new URL(item.href, Astro.site)} />),
        <link rel="alternate" hreflang="x-default" href={new URL(languages[0]!.href, Astro.site)} />,
      ]
    }
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf5ec" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={language.locale} />
    {
      translated &&
        languages
          .filter((item) => item.code !== lang)
          .map((item) => <meta property="og:locale:alternate" content={item.locale} />)
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${hero.eventLine.join(' · ')}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <Header languages={languages} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      class:list={['btn btn--primary sticky-help', { 'is-hidden': stickyStartsHidden }]}
      href={link('/#help')}
    >
      {site.helpButton}
      <Arrow />
    </a>

    <script>
      // Поява блоків при скролі
      function initReveal() {
        const items = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => observer.observe(el));
      }

      // Закріплена кнопка ховається, поки на екрані видно елементи з data-sticky-hide:
      // таку саму кнопку в тексті або секції «Як допомогти» й «Контакти»
      function initSticky() {
        const bar = document.querySelector('.sticky-help');
        const targets = document.querySelectorAll('[data-sticky-hide]');
        if (!bar) return;
        if (!targets.length || !('IntersectionObserver' in window)) {
          bar.classList.remove('is-hidden');
          return;
        }
        const visible = new Set<Element>();
        // Те, що сховане під шапкою, видимим не вважаємо (+1 px: край, що лише торкається шапки, теж не рахуємо)
        const header = (document.querySelector<HTMLElement>('.header')?.offsetHeight ?? 0) + 1;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
            }
            bar.classList.toggle('is-hidden', visible.size > 0);
          },
          { rootMargin: `-${header}px 0px 0px 0px` },
        );
        targets.forEach((el) => observer.observe(el));
      }

      // Звідки прийшли: мітка ?from=telegram у посиланні або сайт, з якого перейшли.
      // Пам’ятаємо до кінця візиту: посилання меню (/#help) перезавантажують сторінку вже без мітки
      // Без мітки: вбудований браузер застосунку видно з User-Agent (сам User-Agent не зберігаємо),
      // а сайт чи застосунок на Android — з referrer (l.facebook.com, android-app://org.telegram.messenger).
      // Месенджери на iPhone нічого не передають, такі візити лишаються без джерела
      const IN_APP: [RegExp, string][] = [
        [/messenger|orca-android/i, 'messenger'],
        [/fban|fbav|fb_iab|fbios/i, 'facebook'],
        [/instagram/i, 'instagram'],
        [/musical_ly|bytedancewebview|tiktok/i, 'tiktok'],
        [/telegram/i, 'telegram'],
        [/viber/i, 'viber'],
      ];
      const REFERRERS: [RegExp, string][] = [
        [/telegram|^t\.me$/, 'telegram'],
        [/viber/, 'viber'],
        [/whatsapp/, 'whatsapp'],
        [/messenger|facebook\.orca|^m\.me$/, 'messenger'],
        [/facebook|^fb\.(com|me)$/, 'facebook'],
        [/instagram/, 'instagram'],
        [/tiktok|musically/, 'tiktok'],
        [/youtube/, 'youtube'],
        [/android\.gm$|mail\.google/, 'gmail'],
        [/google/, 'google'],
      ];
      const match = (value: string, rules: [RegExp, string][]) => rules.find(([re]) => re.test(value))?.[1];

      function getSource() {
        const from = (new URLSearchParams(location.search).get('from') ?? '')
          .toLowerCase()
          .replace(/[^a-z0-9_-]/g, '')
          .slice(0, 30);
        let referrer = '';
        try {
          const host = document.referrer ? new URL(document.referrer).host.toLowerCase() : '';
          if (host && host !== location.host) referrer = match(host, REFERRERS) ?? host.replace(/^www\./, '');
        } catch {}
        const fresh = from || match(navigator.userAgent, IN_APP) || referrer;
        let source = fresh;
        let stored = '';
        let visit = '';
        try {
          stored = sessionStorage.getItem('source') ?? '';
          visit = sessionStorage.getItem('visit') ?? '';
          if (fresh) sessionStorage.setItem('source', fresh);
          else source = stored;
        } catch {}
        // Новий візит: перше відкриття сайту в цій вкладці або прихід із нового джерела.
        // Перезавантаження й переходи в тому самому візиті не рахуємо вдруге
        const landing = !visit || (Boolean(fresh) && fresh !== stored);
        if (landing) {
          // Випадковий номер візиту, щоб зібрати кліки одного візиту разом. Живе, поки відкрита вкладка
          visit = crypto.randomUUID?.() ?? String(Math.random()).slice(2);
          try {
            sessionStorage.setItem('visit', visit);
          } catch {}
        }
        return { source, visit, landing };
      }

      // Лічильник кліків по всіх посиланнях і кнопках. Надсилає, що натиснули (data-link або адресу),
      // де на сторінці, підпис, ім’я з картки контакту, звідки прийшли, мову сторінки й номер візиту — і нічого про людину.
      // Перемикання мови — клік lang-en з мовою сторінки, з якої перемкнули. Далі functions/api/click.ts
      function initClicks() {
        if (!('sendBeacon' in navigator)) return;
        const { source, visit, landing } = getSource();
        const lang = document.documentElement.lang;
        const send = (data: { link: string; place?: string; label?: string; contact?: string; seconds?: number }) =>
          navigator.sendBeacon('/api/click', JSON.stringify({ ...data, source, lang, visit }));
        // Прихід на сайт рахуємо окремо: з нього починається шлях візиту, а канали порівнюються як прийшли → натиснули
        if (landing) send({ link: 'landing' });
        // Час на сторінці: рахуємо, лише поки вкладку видно. Щоразу, як її ховають (закрили, перейшли
        // в іншу вкладку чи застосунок), надсилаємо time із секундами від минулого разу — сума по візиту дає весь час
        let shownAt = document.visibilityState === 'visible' ? Date.now() : 0;
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            shownAt = Date.now();
            return;
          }
          if (!shownAt) return;
          const seconds = Math.round((Date.now() - shownAt) / 1000);
          shownAt = 0;
          if (seconds > 0) send({ link: 'time', seconds });
        });
        const placeOf = (el: Element) => {
          if (el.closest('dialog')) return 'lightbox';
          if (el.closest('.sticky-help')) return 'sticky';
          if (el.closest('.header')) return 'header';
          if (el.closest('.footer')) return 'footer';
          return el.closest('section[id]')?.id ?? '';
        };
        // capture: клік зарахується, навіть якщо інший обробник зупинить його поширення
        document.addEventListener(
          'click',
          (e) => {
            const el = (e.target as Element | null)?.closest<HTMLElement>('a[href], button');
            if (!el) return;
            const label = (el.getAttribute('aria-label') ?? el.textContent ?? '').replace(/\s+/g, ' ').trim();
            const contact = el.closest<HTMLElement>('[data-contact]')?.dataset.contact ?? '';
            const link = el.dataset.link ?? el.getAttribute('href') ?? 'button';
            send({ link, place: placeOf(el), label, contact });
          },
          true,
        );
      }

      initSticky();
      initReveal();
      initClicks();
    </script>
  </body>
</html>

<style>
  /* Кнопка «Допомогти», закріплена внизу екрана, поки в шапці меню-бургер (до 64em, див. Header.astro) */
  .sticky-help {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    min-height: 3.25rem;
    box-shadow: var(--shadow-lg);
    transition:
      transform var(--t-base) var(--ease),
      opacity var(--t-base) var(--ease),
      visibility 0s;
  }

  :global(.js) .sticky-help.is-hidden {
    visibility: hidden;
    opacity: 0;
    transform: translateY(150%);
    transition-delay: 0s, 0s, var(--t-base);
  }

  @media (min-width: 64em) {
    .sticky-help {
      display: none;
    }
  }
</style>
